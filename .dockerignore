# Local development artifacts do not belong in the build context: the Node
# toolchain (commitlint, lefthook, prettier — the pnpm install CONTRIBUTING
# requires), the built binary, and the black-box test tree.
.git
.claude
bin
e2e
node_modules

# Provider credentials — the compose env_file plus token_file: secrets
# (config.example.yaml suggests relay-token.secret) — must never ride the
# build context, let alone the image.
relay.env
*.secret
