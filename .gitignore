bin/
.claude/
node_modules/

# A compiled binary once landed at the root by accident; keep it out.
/http-relay-gateway

# Local desired-state files carry relay identities and reference secrets;
# every real deployment names its own file. Never committed.
config.yaml
config.*.yaml
# The committed reference layout is the one deliberate exception.
!config.example.yaml

# Provider credentials for the compose deployment (compose.yaml env_file).
relay.env

# token_file: secrets — config.example.yaml suggests relay-token.secret;
# a credential file, same rule as relay.env. Never committed.
*.secret
/data/
